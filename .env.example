# Copy to .env.local for local development. Never commit real values.
# Supabase dashboard -> Project Settings -> API (or Data API / API Keys).

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public client key: the "anon" key or the newer "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin key: the "service_role" key or the newer "secret" key (sb_secret_...).
# Used only by the Admin "invite user" action. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
